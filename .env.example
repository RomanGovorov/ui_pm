# ─── Database ────────────────────────────────────────────────────────
DB_NAME="pm_db"
DB_USER="pm_user"
DB_PASSWORD="CHANGE_ME_secure_password"
DATABASE_URL="postgresql://pm_user:CHANGE_ME_secure_password@localhost:5432/pm_db?schema=public&connection_limit=10"

# ─── API Key (AI agent) ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
API_KEY="CHANGE_ME_64_hex_characters_for_primary_key"
# Optional secondary key for zero-downtime rotation
# API_KEY_SECONDARY="CHANGE_ME_64_hex_characters_for_secondary_key"

# ─── JWT Secret (browser auth) ─────────────────────────────────────
# Minimum 64 hex characters (32 bytes). AUTH-003: validated at startup.
# Generate with: openssl rand -hex 48
JWT_SECRET="CHANGE_ME_96_hex_characters_for_jwt_signing_minimum_64"

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ─── Registration ──────────────────────────────────────────────────
# Set to 'false' to disable registration after initial user setup (AUTH-009)
REGISTRATION_ENABLED="true"

# ─── Production Secrets ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Never commit real values — use .env (gitignored) on production host
API_KEY="CHANGE_ME_64_hex_characters_for_primary_key"
JWT_SECRET="CHANGE_ME_96_hex_characters_for_jwt_signing_minimum_64"
