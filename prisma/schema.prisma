generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  backlog
  in_work
  review
  done
}

enum TaskPriority {
  high
  medium
  low
}

enum UserRole {
  admin
  stakeholder
  agent
}

model Project {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subprojects Subproject[]
  tasks       Task[]

  @@map("projects")
}

model Subproject {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@unique([projectId, name])
  @@map("subprojects")
}

model Task {
  id           String       @id @default(uuid())
  projectId    String       @map("project_id")
  subprojectId String?      @map("subproject_id")
  title        String       @db.VarChar(200)
  description  String?      @db.VarChar(2000)
  status       TaskStatus   @default(backlog)
  priority     TaskPriority @default(medium)
  assignee     String       @db.VarChar(100)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subproject Subproject? @relation(fields: [subprojectId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([status])
  @@index([assignee])
  @@map("tasks")
}

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  email        String?  @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  role         UserRole @default(stakeholder)
  apiKey       String?  @unique @map("api_key") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}
